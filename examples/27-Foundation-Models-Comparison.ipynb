   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-17",
   "metadata": {},
   "source": [
    "## 3. Performance Characteristics\n",
    "\n",
    "Let's compare speed and accuracy across different forecast horizons."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-18",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test different forecast horizons\n",
    "horizons = [6, 12, 24]\n",
    "results = []\n",
    "\n",
    "for h in horizons:\n",
    "    print(f\"\\nTesting horizon: {h} months...\")\n",
    "    \n",
    "    # TimesFM\n",
    "    start = time.time()\n",
    "    tf_pred = timesfm_model.predict(n=h, series=train)\n",
    "    tf_time = time.time() - start\n",
    "    tf_error = mape(val[:h], tf_pred)\n",
    "    \n",
    "    # Chronos\n",
    "    start = time.time()\n",
    "    ch_pred = chronos_model.predict(n=h, series=train)\n",
    "    ch_time = time.time() - start\n",
    "    ch_error = mape(val[:h], ch_pred)\n",
    "    \n",
    "    results.append({\n",
    "        'Horizon': h,\n",
    "        'TimesFM_MAPE': tf_error,\n",
    "        'TimesFM_Time': tf_time,\n",
    "        'Chronos_MAPE': ch_error,\n",
    "        'Chronos_Time': ch_time\n",
    "    })\n",
    "\n",
    "results_df = pd.DataFrame(results)\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"PERFORMANCE ACROSS HORIZONS\")\n",
    "print(\"=\"*80)\n",
    "print(results_df.to_string(index=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-19",
   "metadata": {},
   "outputs": [],
   "source": [
