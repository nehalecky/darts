    "\n",
    "# MAPE comparison\n",
    "ax = axes[0]\n",
    "ax.plot(results_df['Horizon'], results_df['TimesFM_MAPE'], marker='o', label='TimesFM', linewidth=2)\n",
    "ax.plot(results_df['Horizon'], results_df['Chronos_MAPE'], marker='s', label='Chronos 2', linewidth=2)\n",
    "ax.set_xlabel('Forecast Horizon (months)')\n",
    "ax.set_ylabel('MAPE (%)')\n",
    "ax.set_title('Accuracy Comparison')\n",
    "ax.legend()\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "# Speed comparison\n",
    "ax = axes[1]\n",
    "ax.plot(results_df['Horizon'], results_df['TimesFM_Time'], marker='o', label='TimesFM', linewidth=2)\n",
    "ax.plot(results_df['Horizon'], results_df['Chronos_Time'], marker='s', label='Chronos 2', linewidth=2)\n",
    "ax.set_xlabel('Forecast Horizon (months)')\n",
    "ax.set_ylabel('Inference Time (seconds)')\n",
    "ax.set_title('Speed Comparison')\n",
    "ax.legend()\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "plt.suptitle('Performance Characteristics', fontsize=14, fontweight='bold', y=1.02)\n",
